# Ports — change these if 5000/3001 are already taken on your machine.
# FRONTEND_PORT: port this app (dev or built) listens on.
# BACKEND_PORT: port the Express backend listens on — used to build the
#   built-in dev/prod proxy target for /api and /health (see vite.config.ts),
#   so the browser can keep calling relative "/api/..." URLs.
FRONTEND_PORT=5000
BACKEND_PORT=3001

# Optional: only set this if the backend is NOT reachable via the built-in
# proxy above (e.g. it's deployed separately from this frontend). Leave
# empty for normal local development.
VITE_API_BASE_URL=

# Optional: Google Maps JavaScript API browser key.
# Leave empty to run with graceful map fallbacks.
VITE_GOOGLE_MAPS_API_KEY=
