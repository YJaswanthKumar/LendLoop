# Server
# Port the backend listens on. Change to 3000, 8080, etc. if you want a
# different port — just make sure it doesn't clash with the frontend's port.
PORT=3001
NODE_ENV=development

# Supabase — from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT — generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# CORS — must exactly match the URL the frontend runs on (no trailing slash).
# "*" works for local development (this API uses Bearer tokens, not cookies),
# but you should lock this down to your real frontend URL in production.
CLIENT_URL=http://localhost:5000
